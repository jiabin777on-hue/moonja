pool one
  depth = 1
rule slow
  command = node t.js cp $in $out
  pool = one
rule loud
  command = node t.js echo console says hi
  pool = console
build a1: slow p.in
build a2: slow p.in
build a3: slow p.in
# After a3, so that the console edge does not race the pool for the
# progress numbers.
build talk: loud || a3
build all: phony a1 a2 a3 talk
